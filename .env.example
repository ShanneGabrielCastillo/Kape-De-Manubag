# =============================================================================
#  Kape De Manubag - Environment Configuration
# =============================================================================
#  Copy this file to .env and adjust the values:
#    Windows:       copy .env.example .env
#    Mac / Linux:   cp .env.example .env
#
#  Settings are read from the .env file in the project root (see README.md).

# -----------------------------------------------------------------------------
#  DEVELOPMENT (local machine) - the active values below give you a working
#  local setup out of the box.
# -----------------------------------------------------------------------------

# True enables Django's detailed error pages and allows development defaults
# (a fallback SECRET_KEY and localhost ALLOWED_HOSTS).
# Never set DEBUG=True in production.
DEBUG=True

# Optional in development. If unset, a safe development-only key is used and
# a startup warning is printed. Always set a real key in production.
# SECRET_KEY=

# Optional in development. Defaults to localhost, 127.0.0.1, [::1].
# ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
#  PRODUCTION (e.g. PythonAnywhere) - uncomment and fill in these values.
# -----------------------------------------------------------------------------
#  With DEBUG=False the app refuses to start (fail-safe) if the required
#  variables are missing, so an insecure configuration can never go live
#  silently.
#  IMPORTANT: also uncomment DEBUG=False below - the active DEBUG=True above
#  is only for local development.
#
#  Generate a SECRET_KEY with:
#      python -c "import secrets; print(secrets.token_urlsafe(50))"
#
# SECRET_KEY=replace-with-a-long-random-string-50-chars-minimum
# DEBUG=False
# ALLOWED_HOSTS=yourusername.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
#
# -----------------------------------------------------------------------------
#  SESSION SECURITY (optional, sensible defaults shown)
# -----------------------------------------------------------------------------
#  Absolute maximum session lifetime in seconds (default: 24 hours).
# SESSION_COOKIE_AGE=86400
#  Idle timeout: logged-in sessions expire after this many minutes of
#  inactivity (default: 30). Set to 0 to disable the idle timeout.
# SESSION_IDLE_TIMEOUT_MINUTES=30
#
#  Session/CSRF cookies are always HttpOnly (session) and SameSite=Lax, and
#  are marked Secure automatically in production (DEBUG=False). No need to
#  set these by hand unless you must override the defaults.
