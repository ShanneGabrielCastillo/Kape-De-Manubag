# =============================================================================
#  Kape De Manubag - Environment Configuration
# =============================================================================
#  Copy this file to .env and adjust the values:
#    Windows:       copy .env.example .env
#    Mac / Linux:   cp .env.example .env
#
#  Settings are read from the .env file in the project root (see README.md).
#  Never commit a real .env or .env.prod file; only templates like this one
#  belong in Git.
# =============================================================================

# -----------------------------------------------------------------------------
#  DEVELOPMENT (local machine) - the active values below give you a working
#  local setup out of the box.
# -----------------------------------------------------------------------------
# True enables Django's detailed error pages and allows development defaults
# (a fallback SECRET_KEY and localhost ALLOWED_HOSTS). Never use it in
# production: production (DEBUG=False) refuses to start without SECRET_KEY,
# ALLOWED_HOSTS and a deliberate database choice.
DEBUG=True

# Optional in development. If unset, a safe development-only key is used and
# a startup warning is printed. Always set a real key in production.
# SECRET_KEY=

# Optional in development. Defaults to localhost, 127.0.0.1, [::1].
# ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
#  PRODUCTION - uncomment and fill in these values.
# -----------------------------------------------------------------------------
# With DEBUG=False the app refuses to start (fail-safe) if SECRET_KEY,
# ALLOWED_HOSTS or the database choice is missing, so an insecure
# configuration cannot go live silently.
#
# Generate a SECRET_KEY with:
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
#
# SECRET_KEY=replace-with-a-long-random-string-50-chars-minimum
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------------------------------------------------
#  DATABASE
# -----------------------------------------------------------------------------
# Selection rules:
#   DATABASE_URL set                              -> PostgreSQL
#   DEBUG=True, no DATABASE_URL                   -> SQLite (development)
#   DEBUG=False, no DATABASE_URL, opt-in enabled  -> SQLite (deliberate)
#   DEBUG=False, no DATABASE_URL, no opt-in       -> refuse to start
#   DATABASE_URL + ALLOW_SQLITE_IN_PRODUCTION=1   -> refuse (ambiguous)
#
# PostgreSQL (production target). Credentials belong only in the real env file
# or the hosting platform, never in Git:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# SQLite file location. Defaults to <project>/db.sqlite3 when unset.
# In a container, point this at a persistent directory, e.g.:
# SQLITE_PATH=/app/data/db.sqlite3
#
# SQLITE_PATH only chooses the file location. It never authorizes SQLite in
# production; use the explicit opt-in below.
# SQLITE_PATH=

# Explicit SQLite opt-in for DEBUG=False. Accepts 1/true/yes/on/y.
# A false or empty value does not enable it. Leave unset for PostgreSQL.
# ALLOW_SQLITE_IN_PRODUCTION=1

# -----------------------------------------------------------------------------
#  LOGGING / GUNICORN (container and service startup)
# -----------------------------------------------------------------------------
# When enabled, logs go to stdout/stderr and no log files are created. Use
# this for read-only container filesystems.
# LOG_TO_STDOUT=1

# Gunicorn worker-heartbeat timeout in seconds (default 120).
# GUNICORN_TIMEOUT=120

# Port Gunicorn binds to (gunicorn.conf.py default: 10000; set explicitly
# when the container port mapping expects another port, e.g. 8000).
# PORT=8000

# Number of Gunicorn workers. Keep at 1 when using SQLite (single writer).
# WEB_CONCURRENCY=1

# -----------------------------------------------------------------------------
#  MEDIA (Cloudinary is required only if it is the chosen media backend)
# -----------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
#  EMAIL
# -----------------------------------------------------------------------------
# Password-reset mail uses the Resend HTTP API (RESEND_API_KEY). The SMTP
# settings are read by Django's email backend and are optional.
# RESEND_API_KEY=
# DEFAULT_FROM_EMAIL=Kape De Manubag <noreply@yourdomain.com>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# PASSWORD_RESET_TIMEOUT=259200

# -----------------------------------------------------------------------------
#  MULTI-FACTOR AUTHENTICATION
# -----------------------------------------------------------------------------
# Required when DEBUG=False unless MFA_ALLOW_SECRET_KEY_FALLBACK is enabled.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MFA_ENCRYPTION_KEY=
# MFA_ALLOW_SECRET_KEY_FALLBACK=False
# MFA_REQUIRE_ADMIN_ENROLLMENT=False

# -----------------------------------------------------------------------------
#  SESSION SECURITY (optional, sensible defaults shown)
# -----------------------------------------------------------------------------
# Absolute maximum session lifetime in seconds (default: 24 hours).
# SESSION_COOKIE_AGE=86400
# Idle timeout: logged-in sessions expire after this many minutes of
# inactivity (default: 30). Set to 0 to disable the idle timeout.
# SESSION_IDLE_TIMEOUT_MINUTES=30

# -----------------------------------------------------------------------------
#  ORDER RATE LIMITING
# -----------------------------------------------------------------------------
# ORDER_RATE_LIMIT=3
# ORDER_RATE_WINDOW=600

# -----------------------------------------------------------------------------
#  AI / CHATBOT (optional; deterministic fallback is used when unset)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=

# -----------------------------------------------------------------------------
#  SUPERUSER BOOTSTRAP (used by the Render build script only)
# -----------------------------------------------------------------------------
# The password is validated against the project policy and never printed.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=
